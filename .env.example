# ==============================================================================
# SIH26002 AI Smart Logistics & Accessibility Intelligence Platform (NER)
# Environment Configuration Template
# ==============================================================================

# Core Application
ENVIRONMENT=development
PROJECT_NAME="SIH26002 NER Smart Logistics & Accessibility Intelligence Platform"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Local default: sqlite:///./sih26002.db
# Production: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=sqlite:///./sih26002.db
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_database_name

# Security & Authentication (RBAC)
JWT_SECRET_KEY=replace_with_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-vercel-app.vercel.app

# External Intelligence APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OSRM_BASE_URL=https://router.project-osrm.org
ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup

# Model Registry & Storage
MODEL_REGISTRY_PATH=./ml/saved_models
UPLOAD_DIR=./backend/static/uploads
MAX_UPLOAD_SIZE_MB=5
