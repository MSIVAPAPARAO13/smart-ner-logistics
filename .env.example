# ==============================================================================
# SIH26002 AI Smart Logistics & Accessibility Intelligence Platform (NER)
# Environment Configuration Template
# ==============================================================================

# Core Application
ENVIRONMENT=production
PROJECT_NAME="SIH26002 NER Smart Logistics & Accessibility Intelligence Platform"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL with PostGIS)
# For local development without Docker, defaults to SQLite: sqlite:///./sih26002.db
DATABASE_URL=postgresql://sih_admin:sih_secret_pass_2026@localhost:5432/sih26002_ner
POSTGRES_USER=sih_admin
POSTGRES_PASSWORD=sih_secret_pass_2026
POSTGRES_DB=sih26002_ner

# Security & Authentication (RBAC)
JWT_SECRET_KEY=ner_smart_logistics_jwt_secret_key_2026_mdoner
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# External Intelligence APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OSRM_BASE_URL=https://router.project-osrm.org
ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup

# Model Registry & Storage
MODEL_REGISTRY_PATH=./ml/saved_models
UPLOAD_DIR=./backend/static/uploads
MAX_UPLOAD_SIZE_MB=5
