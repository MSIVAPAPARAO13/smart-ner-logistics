# SIH26002 Configuration
PROJECT_NAME="SIH26002 - NER Accessibility & Logistics Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="sih26002_development_secret_key_change_in_production"
DEBUG=True

# Database Configuration (PostgreSQL/PostGIS with SQLite GeoJSON fallback)
DATABASE_URL="sqlite:///./sih26002.db"
# For PostgreSQL/PostGIS in production/docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sih26002_gis"

# OSRM Routing Engine URL
OSRM_BASE_URL="https://router.project-osrm.org"
# For local high-speed OSRM:
# OSRM_BASE_URL="http://localhost:5000"

# Open-Meteo Weather & Elevation APIs
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_ELEVATION_URL="https://api.open-meteo.com/v1/elevation"

# North East India Central Reference Coordinates
DEFAULT_LATITUDE=26.1445
DEFAULT_LONGITUDE=91.7362
DEFAULT_ZOOM=8

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
