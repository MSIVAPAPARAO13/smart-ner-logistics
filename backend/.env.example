# SIH26002 Configuration
PROJECT_NAME="SIH26002 - NER Accessibility & Logistics Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_secure_secret"
DEBUG=True

# Database Configuration
# Local default: sqlite:///./sih26002.db
# Production: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="sqlite:///./sih26002.db"

# OSRM Routing Engine URL
OSRM_BASE_URL="https://router.project-osrm.org"

# Open-Meteo Weather & Elevation APIs
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_ELEVATION_URL="https://api.open-meteo.com/v1/elevation"

# North East India Central Reference Coordinates
DEFAULT_LATITUDE=26.1445
DEFAULT_LONGITUDE=91.7362
DEFAULT_ZOOM=8

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "https://your-vercel-app.vercel.app"]

# Optional provider credentials
GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""
UPLOAD_DIR="./backend/static/uploads"
